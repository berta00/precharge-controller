	)
	(text "Input: V_{in} = 16V to 24V\nOutput: V_{out} = 12V\n\nMax current draw: < 1mA\n\nSizing Reverse polarity & Gate protection:\nQ1:\n	\nR1 = 10K (max \nD1 = 15V (max V_{GS}_{protected} = 15V < max V_{GS}_{nominal} = 20V)\n\nSizing Transient overvoltage protection:\nR28 = \nD2 = 28V (max V_{L7812ABV_IN}_{protected} = V_{D2}_{clamp} = 28V < max V_{L7812ABV_IN}_{nominal} = 35V)\n\nSizing Linear voltage stabilizer:\nC1 = 0.33uF as L7812ABV's datasheet directions (multilayer ceramic)\nC2 = 0.1uF as L7812ABV's datasheet directions (multilayer ceramic)\n"
		(exclude_from_sim no)
		(at 46.228 61.976 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "20f7050d-06b0-444e-b23e-f95e3706c90a")
	)
