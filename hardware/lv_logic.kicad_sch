	(text "Enable 50ms timer"
		(exclude_from_sim no)
		(at 44.196 23.368 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3ffaa35e-7869-48cf-bb3c-04dd3195ae67")
	)
	(text "Input: V_{ENABLE_IN} = 5V to 24V\nOutput: V_{ENABLE_delayed} = 0V / 12V (50ms falling-edge delay)\n\nSizing ENABLE Level Shifter:\nQ4 = 2N7002K (V_{GS(th)} = 1V to 2.5V < V_{ENABLE_min} = 5V, max V_{DS} = 60V > 12V)\nR10 = 10kOhm pull-up to 12V (I_{R10_max} = 12V / 10kOhm = 1.2mA)\nR11 = 100kOhm gate pull-down to GND (I_{R11_max} = 24V / 100kOhm = 0.24mA)\n\nSizing 50ms Enable Timer:\nIC3 = CD40106B Schmitt Trigger Inverter (V_{DD} = 12V, V_{p} = 7.1V)\ntau = -t_{delay} / ln(1 - V_{p} / V_{DD}) = -0.05s / ln(1 - 7.1V / 12V) = 0.0558s\nC6 = 1uF (multilayer ceramic)\nR6 = 56kOhm -> t_{delay} = -56kOhm * 1uF * ln(1 - 7.1V / 12V) = 50.16ms)\nR19 = 100Ohm (I_{peak} = 12V / 100Ohm = 120mA)\nD5 = 1N4148 diode (max I_{F} = 200mA > 120mA)"
		(exclude_from_sim no)
		(at 85.725 52.705 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4d7c2276-0174-4d01-9709-6e70b4d97c50")
	)
	(text "Local decoupling for IC2, IC3, IC5"
		(exclude_from_sim no)
		(at 126.746 104.648 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "afc95214-05de-42bb-97e5-a4f8ee89fb1b")
	)
	(text "Logic"
		(exclude_from_sim no)
		(at 168.656 23.368 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ce841957-ed89-49c3-af31-b2fac08ca4dd")
	)
	(text "Input: V_{ENABLE_delayed} = 0V / 12V, V_{CHARGE_REQUIRED_IN} = 0V / 12V, +12V_SHDW, +12V_LOGIC\nOutput: V_{CMD_AIR_NEG}, V_{CMD_AIR_PRE}, V_{CMD_AIR_POS} = 0V / 12V\n\nMax current draw:\nI_{IC2} + I_{IC3} + I_{IC5} = 5uA + 5uA + 5uA = 15uA (< 1mA)\n\nSizing Logic Gates & Input Protection:\nIC2 = CD4081B (Quad AND Gate, V_{DD} = 12V, V_{IH_min} = 8.4V, V_{IL_max} = 3.6V)\nIC5 = CD4071B (Quad OR Gate, SR latch & completion memory)\nR18 = 1kOhm current limiting (max V_{spike} = I_{clamp_max} * R18 + V_{c} = 10mA * 1kOhm + 12.5V = 22.5V)\nR24 = 10kOhm (V_{in_high} = 12V * R24 / (R18 + R24) = 12V * 10kOhm / 11kOhm = 10.9V > V_{IH_min} = 8.4V)\nC7, C8, C13 = 0.1uF as CD4000B's datasheet directions (multilayer ceramic)"
		(exclude_from_sim no)
		(at 45.974 86.868 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "fb6e1e5f-5b28-4bd2-9f94-87f2e986c7d8")
	)
